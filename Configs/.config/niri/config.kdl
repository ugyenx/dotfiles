// ~/.config/niri/config.kdl
// Niri config modelled on your Hyprland setup (Mod = Super key).
// Niri reloads this file automatically when you save it.
// Check for mistakes any time with:  niri validate

// ───────────── Includes ─────────────
// Monitor layout generated by nwg-displays, and Noctalia's generated theme.
include "monitor.kdl"
include "noctalia.kdl"

// ───────────── Startup ─────────────
spawn-at-startup "noctalia"
// Niri starts xwayland-satellite on its own if it is installed (for X11 apps).

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// ───────────── Input ─────────────
input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }

    mouse {
        // accel-profile "flat"
    }
}

// ───────────── Layout ─────────────
layout {
    gaps 12
    center-focused-column "never"

    // Cycle through these widths with Mod+R
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2.5
    }

    border {
        off
    }
}

// ───────────── Window rules ─────────────
// Rounded corners on every window.

window-rule {
    geometry-corner-radius 25
    clip-to-geometry true
    draw-border-with-background false
}

// Noctalia's settings window opens floating.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}


window-rule {
    match app-id="pavucontrol"
    open-floating true
}
// Needed so notification actions and window activation work from Noctalia.
debug {
    honor-xdg-activation-with-invalid-serial
}


// Slightly see-through when not focused, a bit less when focused
window-rule {
    opacity 0.88
}

window-rule {
    match is-active=true
    opacity 0.92
}
// ───────────── Optional blur (newer niri only) ─────────────
// Uncomment these, then run `niri validate`. If it errors, your niri is too
// old for blur: update with `sudo pacman -Syu` or leave them commented.
//
window-rule {
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
// Place the regular wallpaper on the backdrop.
layer-rule {
  match namespace="^noctalia-wallpaper"
  place-within-backdrop true
}


blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

//───────────── Keybinds ─────────────
binds {
    // ── Apps (same as Hyprland) ──
    Mod+Return { spawn "kitty"; }
    Mod+B      { spawn "zen-browser"; }
    Mod+E      { spawn "thunar"; }
    Mod+C      { spawn "code"; }

    // ── Windows ──
    Mod+Q { close-window; }
    Mod+M { quit; }                              // asks for confirmation
    Mod+Shift+Space { toggle-window-floating; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R       { switch-preset-column-width; }
    Mod+Ctrl+C  { center-column; }
    Mod+W       { toggle-column-tabbed-display; }

    // ── Focus (arrow keys, like Hyprland) ──
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // ── Move windows/columns around ──
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    // Put two windows in one column, or pull one back out
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // ── Resize (Mod+Shift+arrows, like Hyprland) ──
    Mod+Shift+Left  { set-column-width "-10%"; }
    Mod+Shift+Right { set-column-width "+10%"; }
    Mod+Shift+Up    { set-window-height "-10%"; }
    Mod+Shift+Down  { set-window-height "+10%"; }
        // ── Multiple monitors (X = "cross over") ──
    Mod+X       { focus-monitor-next; }
    Mod+Shift+X { move-column-to-monitor-next; }
    Mod+Ctrl+X  { move-window-to-monitor-next; }
    Mod+Alt+X   { move-workspace-to-monitor-next; }
        // Resize with one hand, no Shift+arrows needed
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Fill the rest of the screen width with this column
    Mod+D { expand-column-to-available-width; }

    // Jump focus between floating and tiled windows
    Mod+N { switch-focus-between-floating-and-tiling; }

    // ── Workspaces (they stack vertically) ──
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }

    // Mouse wheel: workspaces (and columns with Shift)
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // ── Multiple monitors ──
    Mod+Alt+Left  { focus-monitor-left; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Alt+Shift+Left  { move-column-to-monitor-left; }
    Mod+Alt+Shift+Right { move-column-to-monitor-right; }

    // ── Overview (zoomed-out view of all workspaces) ──
    Mod+Tab { toggle-overview; }
    Mod+O   { toggle-overview; }

    // ── Help ──
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Let a game/VM grab all keys; press again to get shortcuts back
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ── Noctalia ──
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+A     { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab   { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+Shift+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+K       { spawn-sh "noctalia msg panel-toggle kenn/keybind-cheatsheet:cheatsheet"; }
    Mod+Shift+K { spawn-sh "noctalia msg panel-toggle blackbartblues/keymap:panel"; }
    Mod+L         { spawn-sh "noctalia msg session lock"; }
    Mod+Backspace { spawn-sh "noctalia msg panel-toggle session"; }

    // ── Volume / brightness (through Noctalia, so its OSD shows) ──
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ── Media keys (needs playerctl) ──
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }

    // ── Screenshots (Noctalia) ──
    Print       { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Print   { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Mod+Shift+Print { spawn-sh "noctalia msg screenshot-annotate"; }

    // ── Voxtype ──
    // Niri can't detect key *release*, so hold-to-talk isn't possible.
    // This toggles instead: press once to start, press again to stop.
    Mod+V { spawn-sh "voxtype record toggle"; }
}
animations {
    slowdown 0.8

    workspace-switch {
        spring damping-ratio=0.8 stiffness=1100 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.75 stiffness=900 epsilon=0.0001
    }

    // Pop in: starts at 90% size, fades in, overshoots slightly
    window-open {
        spring damping-ratio=0.7 stiffness=900 epsilon=0.0001
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float scale = max(0.0, niri_progress * 0.1 + 0.9);
                coords_geo = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                color *= niri_clamped_progress;
                return color;
            }
        "
    }

    // Shrink out: scales down to 92% while fading
    window-close {
        duration-ms 140
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float scale = 1.0 - niri_clamped_progress * 0.08;
                coords_geo = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                vec4 color = texture2D(niri_tex, coords_tex.st);
                color *= (1.0 - niri_clamped_progress);
                return color;
            }
        "
    }

    // No bounce while resizing, or content jitters
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=0.9 stiffness=1000 epsilon=0.0001
    }
}
