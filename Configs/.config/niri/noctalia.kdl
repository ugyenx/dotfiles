layout {

    focus-ring {
        active-color   "#e46d67"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e46d67"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e46d67"
        inactive-color "#851914"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e46d6780"
    }
}

recent-windows {
    highlight {
        active-color "#e46d67"
        urgent-color "#fd4663"
    }
}
